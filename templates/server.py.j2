# MusicBrainz uses exotic Unicode hyphens/spaces that Lidarr doesn't handle
_UNICODE_REPLACEMENTS: dict[str, str] = {
    "\u2010": "-",   # HYPHEN
    "\u2011": "-",   # NON-BREAKING HYPHEN
    "\u2012": "-",   # FIGURE DASH
    "\u2013": "-",   # EN DASH
    "\u2014": "-",   # EM DASH
    "\u2015": "-",   # HORIZONTAL BAR
    "\u2212": "-",   # MINUS SIGN
    "\u00a0": " ",   # NON-BREAKING SPACE
    "\u2002": " ",   # EN SPACE
    "\u2003": " ",   # EM SPACE
    "\u2009": " ",   # THIN SPACE
    "\u200a": " ",   # HAIR SPACE
    "\u200b": "",    # ZERO WIDTH SPACE
    "\ufeff": "",    # BOM / ZERO WIDTH NO-BREAK SPACE
}

_UNICODE_TABLE = str.maketrans(_UNICODE_REPLACEMENTS)


def _normalize_unicode(text: str) -> str:
    """Normalize exotic Unicode characters to ASCII equivalents."""
    return text.translate(_UNICODE_TABLE)


