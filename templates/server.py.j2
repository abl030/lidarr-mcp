@mcp.tool()
async def lidarr_get_overview() -> dict[str, Any]:
    """Get a system overview: health, disk space, queue, wanted, artist count.

    Returns a unified summary in a single call.
    """
    import asyncio
    health, disk, queue, wanted, artists = await asyncio.gather(
        _client.request("GET", "/api/v1/health"),
        _client.request("GET", "/api/v1/diskspace"),
        _client.request("GET", "/api/v1/queue"),
        _client.request("GET", "/api/v1/wanted/missing", params={"pageSize": 1}),
        _client.request("GET", "/api/v1/artist"),
    )
    return {
        "health": health,
        "diskSpace": disk,
        "queueCount": queue.get("totalRecords", 0) if isinstance(queue, dict) else 0,
        "wantedCount": wanted.get("totalRecords", 0) if isinstance(wanted, dict) else 0,
        "artistCount": len(artists) if isinstance(artists, list) else 0,
    }


@mcp.tool()
async def lidarr_search_tools(keyword: str) -> dict[str, Any]:
    """Search for tools by keyword (e.g. 'artist', 'quality', 'queue').

    Use this tool first to find the right tool before trying to call it directly.
    """
    keyword_lower = keyword.lower()
    matches = []
    for tool in mcp._tool_manager._tools.values():
        if keyword_lower in tool.name.lower() or keyword_lower in (tool.description or "").lower():
            matches.append({"name": tool.name, "description": (tool.description or "")[:120]})
    return {"summary": f"Found {len(matches)} tools matching '{keyword}'", "matches": matches}


@mcp.tool()
async def lidarr_report_issue(
    tool_name: str,
    error_message: str,
    parameters_used: str = "",
    notes: str = "",
) -> str:
    """Generate a structured bug report for unexpected errors.

    Returns a ready-to-paste `gh issue create` command. Makes no HTTP calls.
    If any tool returns an unexpected error, call this to report it.
    """
    body = f"""## Bug Report

**Tool:** `{tool_name}`
**Error:** `{error_message}`
**Parameters:** `{parameters_used}`

### Notes
{notes}

### Environment
- Lidarr MCP Server
- Generated from OpenAPI spec
"""
    title = f"Bug: {tool_name} — {error_message[:60]}"
    cmd = f'gh issue create --repo abl030/lidarr-mcp --title "{title}" --body "$(cat <<\'GHEOF\'\n{body}\nGHEOF\n)"'
    return cmd


